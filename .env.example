# Copy this file to .env.local for local development (scripts/generate-
# environment.mjs reads it and writes src/environments/environment.ts).
# In GitHub Actions, set the same keys as repository secrets instead
# (Settings -> Secrets and variables -> Actions).
#
# These are the standard Firebase Web SDK config values. They are NOT
# secrets in the traditional sense (they identify your Firebase project to
# the browser, same as they would appear in any Firebase web app's bundle),
# but they should still be set per-environment rather than committed with
# real values.
#
# Find these under: Firebase Console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional: restrict Google sign-in to a specific Workspace/consumer domain
# hint (does not enforce anything by itself - enforcement happens via the
# authorized-users Firestore collection and security rules).
GOOGLE_AUTH_HD=

# Demo mode runs the app on in-memory mock data with a pretend signed-in
# user - no Firebase project, no approved account, no real names on screen.
# It is ALWAYS available in a dev build (`npm start`, then visit /?demo=1).
# Set this to "true" only if you also want a production build to offer it;
# leaving it false means a deployed site can't be switched into demo mode.
ENABLE_DEMO_MODE=false

# Public API key for the unauthenticated /boundary page (address ->
# lat/lng via the Google Geocoding API - see core/geocoding.service.ts).
# Like the Firebase values above, this ships inside the public JS bundle,
# so it should be restricted on the Google Cloud Console side rather than
# treated as a secret - but Google's Geocoding "Web Service" REST API
# (what this calls, since there's no backend to proxy through) flatly
# REJECTS a key with an HTTP referrer restriction at request time
# ("API keys with referer restrictions cannot be used with this API"),
# confirmed against a live key. So an "Application restriction" isn't an
# option here (that's meant for browser-side APIs like Maps JavaScript,
# not this REST endpoint) - the only real controls available are:
#   - API restriction: Geocoding API only, so a copied key can't be
#     used against other, potentially more expensive Google APIs
#   - A daily quota low enough that a scraping bot can't run up a bill -
#     Google enforces this as a hard per-day cutoff (OVER_QUERY_LIMIT),
#     not just a billing alert
# This means the key is NOT bound to this site at all - anyone who
# copies it out of the public bundle can call the Geocoding API with it
# from anywhere, up to the shared daily quota. Do not reuse a key that's
# also enabled for other APIs, and don't treat the API restriction as
# more protection than it is.
GOOGLE_GEOCODING_API_KEY=
