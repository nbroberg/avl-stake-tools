rules_version = '2';

// -----------------------------------------------------------------------
// Stake Presidency Tools - Firestore Security Rules
//
// Authorization model: Firebase Authentication only proves WHO someone is.
// Whether they may use the app is decided here, by looking up their own
// users/{uid} document. An authenticated Google account with no active
// users/{uid} record (or active == false) is treated as unauthorized for
// every collection except its own user doc.
//
// Roles: stake_presidency, high_council.
//
// Rule of thumb for HC vs presidency:
// - Presidency owns everything: create/read/update on people and
//   callingWorkflows, and every calling-status transition.
// - High council reads everything, and may only: record their own
//   position (approve / withdraw / raise a concern / clear it) on a
//   workflow at `presidency_approved`; advance that workflow to
//   `high_council_approved` once quorum is met with no concern
//   outstanding; and, from a unit visit on a Sunday, mark a unit
//   sustained, sustain a calling/release (optionally combined with
//   setting the person apart in the same visit), set someone apart on
//   its own, or record a priesthood ordination they performed. No other
//   writes - see isHighCouncilMarkSustainedUnit, isHighCouncilSustain,
//   isHighCouncilSetApart, and isHighCouncilOrdain below.
//
// Users cannot elevate themselves - the users collection is not writable
// from the app; the first admin adds subsequent user docs via the
// Firebase Console.
// -----------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && callerDoc().data.active == true;
    }

    function hasRole(role) {
      return isActiveUser() && callerDoc().data.role == role;
    }

    function isPresidency() {
      return hasRole('stake_presidency');
    }

    function isHighCouncil() {
      return hasRole('high_council');
    }

    function isAnyApprovedUser() {
      return isPresidency() || isHighCouncil();
    }

    // ---------------------------------------------------------------------
    // users - the application's own authorization table.
    //
    // Never writable from the app. New users, role changes, and
    // deactivations are done directly in the Firebase Console, so the app
    // cannot self-elevate no matter what bug or compromise happens
    // client-side. A caller can read only their own doc, so no one can
    // enumerate the presidency/HC roster from the client.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // people - minimal local roster records (name/unit/email/phone only).
    // Both roles read; only presidency creates/updates. Delete is
    // presidency-only too (there's no admin role in the POC).
    // ---------------------------------------------------------------------
    match /people/{personId} {
      allow read: if isAnyApprovedUser();
      allow create, update, delete: if isPresidency();
    }

    // ---------------------------------------------------------------------
    // callingWorkflows - lifecycle tracking + audit history subcollection.
    // History is append-only: no update/delete once written.
    // ---------------------------------------------------------------------
    match /callingWorkflows/{workflowId} {
      allow read: if isAnyApprovedUser();
      allow create: if isPresidency();
      allow delete: if isPresidency();

      // Presidency can update anything. High Council can do these things
      // and nothing else: record their own position on a workflow sitting
      // at `presidency_approved` (approve, withdraw, raise or clear a
      // concern); advance the status once quorum is met with no concern
      // outstanding; and, while physically visiting a unit on a Sunday,
      // mark a unit sustained, sustain (optionally combined with setting
      // apart in the same visit), or set apart on its own.
      allow update: if isPresidency()
        || (isHighCouncil()
            && (isHighCouncilSelfVote()
                || isHighCouncilQuorumAdvance()
                || isHighCouncilMarkSustainedUnit()
                || isHighCouncilSustain()
                || isHighCouncilSetApart()));

      match /history/{entryId} {
        allow read: if isAnyApprovedUser();
        // Anyone who can advance the parent workflow can write the
        // matching history entry. HC members also write a history entry
        // when they cast a vote (they only touch history + the vote
        // array on the parent).
        allow create: if isPresidency() || isHighCouncil();
        allow update, delete: if false;
      }
    }

    /**
     * Every entry in `list` other than the caller's own is untouched.
     * Comparing the two lists with the caller removed is what lets one
     * member change their own vote without being able to add, drop or
     * reorder anyone else's.
     */
    function othersUnchanged(newList, oldList) {
      return newList.removeAll([request.auth.uid])
          == oldList.removeAll([request.auth.uid]);
    }

    /**
     * The caller appears in `list` at most once. Without this a client
     * could write its own UID several times and inflate the tally, since
     * othersUnchanged() alone can't see duplicates.
     */
    function ownEntriesAtMostOne(list) {
      return list.size() - list.removeAll([request.auth.uid]).size() <= 1;
    }

    /**
     * A High Council member changing THEIR OWN position on a workflow
     * sitting at `presidency_approved`. One rule covers all four moves -
     * approve, withdraw an approval, raise a concern, clear a concern -
     * because each is the same shape: the caller's own membership in the
     * two arrays changes, everyone else's is untouched, and nothing
     * outside those arrays and the audit fields moves.
     *
     * A member cannot approve and hold a concern simultaneously, cannot
     * vote on anyone else's behalf, and cannot double-count themselves.
     * Withdrawal is only possible while the vote is still open; once the
     * workflow advances past `presidency_approved`, this rule stops
     * matching and the recorded votes are frozen.
     */
    function isHighCouncilSelfVote() {
      return resource.data.status == 'presidency_approved'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['hcApprovalUids', 'hcConcernUids', 'updatedAt', 'updatedBy'])
        && othersUnchanged(
             request.resource.data.get('hcApprovalUids', []),
             resource.data.get('hcApprovalUids', []))
        && othersUnchanged(
             request.resource.data.get('hcConcernUids', []),
             resource.data.get('hcConcernUids', []))
        && ownEntriesAtMostOne(request.resource.data.get('hcApprovalUids', []))
        && ownEntriesAtMostOne(request.resource.data.get('hcConcernUids', []))
        && !(request.resource.data.get('hcApprovalUids', []).hasAll([request.auth.uid])
             && request.resource.data.get('hcConcernUids', []).hasAll([request.auth.uid]));
    }

    /**
     * Advancing from `presidency_approved` to `high_council_approved`
     * once the workflow has collected enough HC approvals to meet its
     * own snapshotted quorum threshold AND no member is still holding a
     * concern. A concern is not a veto - the presidency keeps its
     * separate unconditional path via `isPresidency()` - but the high
     * council may not advance past one of its own members' objections
     * without the presidency deciding to.
     */
    function isHighCouncilQuorumAdvance() {
      return resource.data.status == 'presidency_approved'
        && request.resource.data.status == 'high_council_approved'
        && resource.data.hcApprovalUids.size() >= resource.data.hcRequired
        && resource.data.get('hcConcernUids', []).size() == 0
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'updatedBy', 'highCouncilApprovedDate']);
    }

    /**
     * A high councilor (or presidency member, via their own unconditional
     * path) recording that a unit has sustained a stake-wide calling,
     * without yet advancing the status - the ordinary case while other
     * units still haven't weighed in. Ward/branch workflows don't use
     * this shape; their one unit's sustaining always finishes them (see
     * isHighCouncilSustain below), so there's no "partial" state to
     * record.
     */
    function isHighCouncilMarkSustainedUnit() {
      return isHighCouncil()
        && (resource.data.status == 'accepted' || resource.data.status == 'released')
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['sustainedInUnits', 'updatedAt', 'updatedBy']);
    }

    /**
     * A high councilor completing the sustaining during a unit visit -
     * either the ordinary "sustained here" case, or the same visit also
     * setting the person apart because the councilor is physically
     * present with them (core/sunday-visit.ts decides which on the
     * client; here we just accept either resulting status). Covers both
     * the calling ladder (accepted -> ...) and the release ladder
     * (released -> ...). setApartBy, when present, must be the caller's
     * own recorded name - they can't attribute the act to anyone else.
     */
    function isHighCouncilSustain() {
      return isHighCouncil()
        && (resource.data.status == 'accepted' || resource.data.status == 'released')
        && (request.resource.data.status == 'sustained'
            || request.resource.data.status == 'set_apart')
        && (request.resource.data.status != 'set_apart'
            || request.resource.data.get('setApartBy', '') == callerDoc().data.displayName)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'status', 'sustainedDate', 'setApartDate', 'setApartBy',
               'sustainedInUnits', 'updatedAt', 'updatedBy',
             ]);
    }

    /**
     * A high councilor setting a person apart on a later visit, after the
     * calling was already sustained (possibly by someone else, on an
     * earlier visit). Same own-name restriction as isHighCouncilSustain.
     */
    function isHighCouncilSetApart() {
      return isHighCouncil()
        && resource.data.status == 'sustained'
        && request.resource.data.status == 'set_apart'
        && request.resource.data.get('setApartBy', '') == callerDoc().data.displayName
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'setApartDate', 'setApartBy', 'updatedAt', 'updatedBy']);
    }

    // ---------------------------------------------------------------------
    // priesthoodAdvancements - Priest->Elder / Elder->High Priest workflow
    // tracking + audit history subcollection. Bishop is not part of this
    // flow (for now) - only stake presidency and high council touch it,
    // so the rule shape is identical to callingWorkflows above and reuses
    // the same isHighCouncilSelfVote()/isHighCouncilQuorumAdvance()
    // helpers verbatim (both read only `resource`/`request.resource` of
    // whichever document is actually being written).
    // ---------------------------------------------------------------------
    match /priesthoodAdvancements/{advancementId} {
      allow read: if isAnyApprovedUser();
      allow create: if isPresidency();
      allow delete: if isPresidency();

      // Also lets a high councilor record an ordination performed during
      // a unit visit on a Sunday, same own-name restriction as setting
      // apart on callingWorkflows above.
      allow update: if isPresidency()
        || (isHighCouncil()
            && (isHighCouncilSelfVote() || isHighCouncilQuorumAdvance() || isHighCouncilOrdain()));

      match /history/{entryId} {
        allow read: if isAnyApprovedUser();
        allow create: if isPresidency() || isHighCouncil();
        allow update, delete: if false;
      }
    }

    /**
     * A high councilor recording a priesthood ordination they performed
     * on a unit visit. Same own-name restriction as isHighCouncilSetApart
     * on callingWorkflows - they can't attribute the ordination to
     * anyone else.
     */
    function isHighCouncilOrdain() {
      return isHighCouncil()
        && resource.data.status == 'high_council_approved'
        && request.resource.data.status == 'ordained'
        && request.resource.data.get('ordainedBy', '') == callerDoc().data.displayName
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'ordainedDate', 'ordainedBy', 'updatedAt', 'updatedBy']);
    }

    // ---------------------------------------------------------------------
    // diagnostics - lightweight per-user connectivity ping, no app data.
    // Any authenticated user may use this, even before being approved, so
    // connectivity from a meetinghouse network can be verified before role
    // assignment.
    // ---------------------------------------------------------------------
    match /diagnostics/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
